PORT=5000

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# EBAY_ENV=sandbox

PLATZI_ENABLED=true

# Optional map of currency values expressed in USD. Defaults include USD, CAD, EUR, and GBP.
# Used as a fallback if live exchange rates cannot be fetched.
# CURRENCY_RATES_JSON={"USD":1,"CAD":0.74,"EUR":1.09,"GBP":1.27}

# Optional: cache live exchange rates for 12 hours by default.
# CURRENCY_RATE_CACHE_TTL_MS=43200000
